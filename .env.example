# Canonical origin used for metadata, Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.dev

# Optional. A read-only GitHub personal access token with no scopes.
# Without it the repository list falls back to a plain profile link whenever
# the unauthenticated rate limit (60 requests/hour/IP) is exhausted.
GITHUB_TOKEN=

# Contact form. Without these the form still works: it hands the composed
# message to the visitor's own mail client instead of sending server-side.
# To send properly, create a free key at https://resend.com and set both.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
# For testing, Resend allows: onboarding@resend.dev
CONTACT_FROM_EMAIL=
