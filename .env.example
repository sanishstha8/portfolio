# Optional. Public origin used for metadata, Open Graph URLs and the sitemap,
# e.g. https://your-domain.com. Leave unset (or empty) on Vercel and the
# project's own production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# Contact form. Without these the form still works: it hands the composed
# message to the visitor's own mail client instead of sending server-side.
# To send properly, create a free key at https://resend.com and set both.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
# For testing, Resend allows: onboarding@resend.dev
CONTACT_FROM_EMAIL=
